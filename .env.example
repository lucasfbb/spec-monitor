# Chave de assinatura de sessão — gere uma: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-me

# Super admin (criado/atualizado no startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-me

# Banco (docker-compose já aponta para o Postgres do stack; sem essa var, usa SQLite local em ./data)
# DATABASE_URL=postgresql+psycopg://specmonitor:specmonitor@postgres:5432/specmonitor

# Intervalo do polling de sincronização (minutos)
SYNC_INTERVAL_MINUTES=10

# STATUS defasado: dias de atraso do STATUS.md em relação à atividade das specs
# a partir dos quais o projeto é sinalizado como defasado no painel/notificação.
STATUS_STALE_DAYS=14

# Segredo do webhook do GitHub (opcional — se vazio, o endpoint de webhook fica desativado)
GITHUB_WEBHOOK_SECRET=

# --- Notificações por e-mail (opcional) ---
# Sem SMTP_HOST, as notificações ficam desativadas (o sync segue normal).
# Enviadas quando o polling/sync manual detecta mudança; destinatários = admins
# + membros do projeto. Canal Telegram fica para depois (ver STATUS, decisão M1).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=            # remetente; se vazio, usa SMTP_USER
SMTP_USE_TLS=true
# Base pública para montar o link do projeto nos e-mails (ex.: https://spec.exemplo.com)
APP_BASE_URL=

# --- Só produção (docker-compose.prod.yml) ---
# Senha do Postgres (o compose de prod exige):
# POSTGRES_PASSWORD=troque-me
